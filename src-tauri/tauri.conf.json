{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ktk-video",
  "version": "0.1.0",
  "identifier": "com.kore-teck.ktk-video",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ktk-video",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Lecteur multimédia moderne et léger",
    "longDescription": "ktk-video est un lecteur multimédia de bureau léger et moderne, offrant lecture vidéo/audio, gestion de playlists et support des sous-titres.",
    "category": "Video",
    "copyright": "Copyright © 2026",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
